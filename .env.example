# Copy to .env and fill in. .env is git-ignored.

# Absolute URL of the live site, without a trailing slash.
# Used for canonical, hreflang, Open Graph, JSON-LD and sitemap URLs.
SITE_URL=https://figlab.hu

# "production" (indexable) or "staging" (noindex + draft banner + placeholder markers).
# `npm run build:staging` forces staging regardless of this value.
SITE_ENV=production

# Optional: the content value of Google Search Console's HTML-tag verification.
GOOGLE_SITE_VERIFICATION=
