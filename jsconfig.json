{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.js", "scripts/**/*.mjs", "scripts/**/*.js"],
  "exclude": ["dist", "node_modules"]
}
